 "p2-45": {
  "principle": [
   "JWT：header.payload.signature；无状态易扩展；风险：密钥泄露、难撤销、载荷过大/敏感。对策：短过期+刷新、黑名单、不放机密。"
  ],
  "example": {
   "lang": "text",
   "code": "Authorization: Bearer eyJ..."
  },
  "asks": [
   "结构？",
   "风险？",
