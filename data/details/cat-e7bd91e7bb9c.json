   "和 Session？"
  ],
  "followups": [
   {
    "q": "算法？",
    "a": "别用 none。"
   },
   {
    "q": "存储？",
    "a": "HttpOnly 防 XSS。"
   },
   {
    "q": "刷新？",
    "a": "双 token。"
   }
