 "p-net2": {
  "principle": [
   "三次握手：SYN/SYN-ACK/ACK 同步序号建连。四次挥手：FIN/ACK/FIN/ACK 半关闭；TIME_WAIT 等 2MSL 防旧包。"
  ],
  "example": {
   "lang": "text",
   "code": "大量 TIME_WAIT：短连接过多，调参数或改长连接/池"
  },
  "asks": [
   "三次四次？",
   "TIME_WAIT？",
   "半关闭？",
   "SYN 洪泛？"
  ],
  "followups": [
   {
    "q": "为何三次？",
    "a": "防旧 SYN。"
   },
   {
    "q": "合并？",
    "a": "有时 ACK+FIN。"
   },
   {
    "q": "队列？",
    "a": "backlog。"
   }
  ],
  "answer": [
   "总：可靠建拆连接。",
   "分：TIME_WAIT 正常。",
   "实践：压测连接。",
   "总结：基础必会。"
  ],
  "pitfalls": [
