{
 "p2-44": {
  "principle": [
   "2xx 成功（200/201/204）；3xx 重定向；4xx 客户端（400 参数、401 未认证、403 无权限、404、429 限流）；5xx 服务端（500/502/503/504）。API 应用语义化状态码+错误体。"
  ],
  "example": {
   "lang": "text",
   "code": "401 vs 403：没登录 vs 没权限\n502 网关下游坏；504 网关等下游超时"
  },
  "asks": [
   "常见状态码？",
   "401 403？",
   "502 504？",
   "业务错误用？"
  ],
  "followups": [
   {
    "q": "业务？",
    "a": "可用 200+code 或 4xx 语义化。"
   },
   {
    "q": "REST？",
    "a": "POST 201。"
   },
   {
    "q": "幂等？",
    "a": "重复可用 200。"
   }
  ],
  "answer": [
