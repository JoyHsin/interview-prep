{
 "p-mb1": {
  "principle": [
   "#{} 预编译占位，防注入。${} 字符串替换，用于动态表名/列名且必须白名单校验。误用 ${} 拼用户输入=SQL 注入。"
  ],
  "example": {
   "lang": "xml",
   "code": "<select>SELECT * FROM user WHERE id=#{id}</select>\n<!-- 表名白名单后 --> FROM ${tableName}"
  },
  "asks": [
   "#{} ${}？",
   "注入？",
   "表名？",
   "order by？"
  ],
  "followups": [
   {
    "q": "排序字段？",
    "a": "白名单映射，勿 ${} 用户输入。"
   },
   {
    "q": " alike？",
    "a": "CONCAT 与 #{}。"
   },
   {
    "q": "原理？",
    "a": "PreparedStatement。"
   }
  ],
  "answer": [
   "总：默认 #{}，${} 仅可信标识符。",
   "分：白名单。",
   "实践：Code Review 查 ${}。",
   "总结：安全第一。"
  ],
  "pitfalls": [
   "${} 拼搜索词。"
  ]
 },
 "p2-39": {
  "principle": [
   "动态 SQL：where/trim/set 去多余 AND；foreach 注意空；${} 仅白名单；过大 if-else 难维护可拆语句或用脚本谨慎。"
  ],
  "example": {
   "lang": "xml",
   "code": "<where><if test=\"name!=null\">AND name=#{name}</if></where>"
  },
  "asks": [
   "动态 SQL 注意？",
   "注入？",
   "维护？",
   "与注解？"
  ],
  "followups": [
   {
    "q": "空集合？",
    "a": "foreach 防语法错。"
   },
   {
    "q": "复杂？",
    "a": "可 XML 分离。"
   },
   {
    "q": "调试？",
    "a": "打日志看最终 SQL。"
   }
  ],
  "answer": [
   "总：标签处理拼接，防 ${} 注入。",
   "分：可维护性。",
   "实践：搜索条件动态。",
   "总结：安全与清晰。"
  ],
  "pitfalls": [
   "用户输入进 ${}。"
  ]
 },
 "p-mb2": {
  "principle": [
   "一级缓存 SqlSession 级默认开；二级 Mapper 命名空间可跨会话，分布式易脏，生产常关或极慎用。本地缓存更新策略复杂。"
  ],
  "example": {
   "lang": "text",
   "code": "mybatis.configuration.cache-enabled=false  # 二缓\n# 分布式用 Redis 业务缓存更清晰"
  },
  "asks": [
   "一二缓？",
   "分布式？",
   "何时开？",
   "和 Redis？"
  ],
  "followups": [
   {
    "q": "脏读？",
    "a": "多实例二缓。"
   },
   {
    "q": "会话？",
    "a": "一缓同会话重复查。"
   },
   {
    "q": "注解？",
    "a": "@CacheNamespace。"
   }
  ],
  "answer": [
   "总：一缓会话，二缓慎用。",
   "分：分布式用外置缓存。",
   "实践：默认关二缓。",
   "总结：缓存层次清晰。"
  ],
  "pitfalls": [
   "多节点开二缓不失效。"
  ]
 }
}